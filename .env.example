# Postgres (used by docker-compose `db` service)
POSTGRES_USER=pluscode
POSTGRES_PASSWORD=pluscode
POSTGRES_DB=pluscode

# Payload CMS
# Connection string for the app.
#   - Host dev (app on host, Postgres in Docker): use localhost:5434
#   - In the `app` container, compose overrides this to point at the db service
DATABASE_URI=postgresql://pluscode:pluscode@localhost:5434/pluscode

# Long random string used to sign tokens. Generate one with:
#   openssl rand -hex 32
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Seed script admin user (optional; defaults live in scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@pluscode.io
SEED_ADMIN_PASSWORD=changeme123

# Google reCAPTCHA v3 (contact form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend email (contact form)
RESEND_API_KEY=
# Email address where contact form submissions are delivered
CONTACT_EMAIL=contact@pluscode.io
